<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barcode Scanner Pro</title>
    <style>
        body { font-family: Arial, sans-serif; background: #121212; color: white; text-align: center; margin: 0; padding: 20px; }
        .container { max-width: 500px; margin: 0 auto; }
        button { width: 100%; padding: 15px; margin: 10px 0; font-size: 18px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; }
        .btn-add { background: #00b300; color: white; }
        .btn-remove { background: #d90000; color: white; }
        video { width: 100%; max-width: 400px; border-radius: 12px; background: #000; margin-top: 10px; }
        .list-box { background: #1e1e1e; padding: 15px; border-radius: 8px; text-align: left; margin-top: 20px; max-height: 300px; overflow-y: auto; font-family: monospace; font-size: 16px; }
        .product-item { margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 10px; }
        .product-header { display: flex; justify-content: space-between; align-items: center; }
        .btn-rename { background: #8a2be2; color: white; width: auto; padding: 5px 12px; margin: 0; font-size: 14px; border-radius: 4px; display: inline-block; }
        .section-title { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 20px; margin-bottom: 5px; font-size: 22px; }
    </style>
</head>
<body>
    <div class="container">
        <h3 id="status-label" style="color: #00b300;">Bereit zum Scannen</h3>
        
        <video id="webcam" autoplay playsinline></video>
        
        <button class="btn-add" onclick="setMode('add')">Hinzufügen (+)</button>
        <button class="btn-remove" onclick="setMode('remove')">Entfernen (-)</button>
        
        <div class="section-title">📦 Lokaler Bestand</div>
        <div class="list-box" id="bestand-liste">Dein Bestand ist leer.</div>
    </div>

    <script>
        let mode = "add";
        let lastScannedCode = "";
        let lastScanTime = 0;
        let barcodeDetector;

        let products = JSON.parse(localStorage.getItem('minimalProducts')) || {};

        window.addEventListener('load', () => {
            if ('BarcodeDetector' in window) {
                barcodeDetector = new BarcodeDetector({ formats: ['ean_13', 'ean_8', 'code_128', 'code_39'] });
            }
            startKamera();
            updateListDisplay();
        });

        function startKamera() {
            navigator.mediaDevices.getUserMedia({ 
                video: { facingMode: "environment", width: { ideal: 1280 }, height: { ideal: 720 } } 
            })
            .then(stream => {
                const video = document.getElementById("webcam");
                video.srcObject = stream;
                video.addEventListener('play', () => {
                    scanSchleife(video);
                });
            })
            .catch(err => {
                console.error(err);
                alert("Kamera-Zugriff blockiert.");
            });
        }

        function scanSchleife(video) {
            setInterval(async () => {
                if (!barcodeDetector || video.paused || video.ended) return;
                
                try {
                    const barcodes = await barcodeDetector.detect(video);
                    if (barcodes && barcodes.length > 0) {
                        
                        // HIER STEHT DIE ECKIGE KLAMMER NULL GEBRANNTMARKT IN ZEILE 83 DRIN!
                        let code = barcodes[0].rawValue;
                        
                        if (!code) return;
                        
                        let now = Date.now();
                        if (code === lastScannedCode && (now - lastScanTime) < 3000) return;
                        
                        lastScannedCode = code;
                        lastScanTime = now;
                        
                        if (window.navigator.vibrate) window.navigator.vibrate(100);

                        if (mode === "add") {
                            if (!products[code]) {
                                products[code] = { rawName: "", datum: "", anzahl: 1 };
                            } else {
                                products[code].anzahl += 1;
                            }
                        } else if (mode === "remove") {
                            if (products[code]) {
                                products[code].anzahl -= 1;
                                if (products[code].anzahl <= 0) delete products[code];
                            }
                        }
                        
                        localStorage.setItem('minimalProducts', JSON.stringify(products));
                        updateListDisplay();
                    }
                } catch (e) { console.error(e); }
            }, 200);
        }

        function renameProduct(code) {
            let item = products[code];
            if (!item) return;

            let nameInput = prompt("1. Name des Produkts eingeben (Tippe 'löschen' zum Entfernen):", item.rawName || "");
            if (nameInput === null) return; 
            
            if (nameInput.trim().toLowerCase() === "löschen") {
                if (confirm("Möchtest du diesen Artikel wirklich komplett löschen?")) {
                    delete products[code];
                    localStorage.setItem('minimalProducts', JSON.stringify(products));
                    updateListDisplay();
                    return;
                }
            }
            
            let datumInput = prompt("2. Ablaufdatum eingeben (oder leer lassen):", item.datum || "");
            if (datumInput === null) return;

            item.rawName = nameInput;
            item.datum = datumInput;

            localStorage.setItem('minimalProducts', JSON.stringify(products));
            updateListDisplay();
        }

        function setMode(newMode) {
            mode = newMode;
            if(newMode === "add") {
                document.getElementById("status-label").innerText = "Bereit zum Scannen";
                document.getElementById("status-label").style.color = "#00b300";
            } else {
                document.getElementById("status-label").innerText = "Bereit zum Entfernen";
                document.getElementById("status-label").style.color = "#d90000";
            }
        }

        function updateListDisplay() {
            const listDiv = document.getElementById("bestand-liste");
            if (!listDiv) return;
            
            let keys = Object.keys(products);
            if (keys.length === 0) {
                listDiv.innerHTML = "Dein Bestand ist leer.";
                return;
            }
            
            let html = "";
            for (let i = 0; i < keys.length; i++) {
                let code = keys[i];
                let item = products[code];
                if (item) {
                    let anzeigeName = item.rawName ? item.rawName : "Neu gescannt: " + code;
                    let anzeigeDatum = item.datum ? " | ⏱️ " + item.datum : "";
                    html += `<div class="product-item"><div class="product-header"><span>• <b>${anzeigeName}${anzeigeDatum}</b> | Anzahl: <b>${item.anzahl} Stk.</b></span><button class="btn-rename" onclick="renameProduct('${code}')">N 🟪</button></div></div>`;
                }
            }
            listDiv.innerHTML = html;
        }
    </script>
</body>
</html>
