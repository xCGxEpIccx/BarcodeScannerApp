# name: Build Android APK
on: [push, workflow_dispatch]

jobs:
  build:
    runs-on: ubuntu-22.04
    env:
      # Define critical paths and versions at the job level for consistency
      ANDROID_API: '33'
      ANDROID_MINAPI: '24'
      NDK_VERSION: '27.3.13750724' # <<< CRITICAL: Verify this NDK version exists!
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      # 1. Setup Python Environment
      - name: Setup Python and Dependencies
        run: |
          echo "Setting up Python 3.10 environment..."
          python3 -m venv venv
          source venv/bin/activate
          pip install --upgrade pip setuptools wheel # Ensure base tools are current

      # 2. Install System Libraries (Using 'set -e' to fail fast)
      - name: Install Build Dependencies
        run: |
          echo "Installing system dependencies..."
          sudo apt-get update
          # Using a combined command ensures all packages are installed together
          sudo apt-get install -y git zip unzip openjdk-17-jdk autoconf libtool pkg-config zlib1g-dev libncurses5-dev libgdbm-dev libncursesw5-dev libsqlite3-dev lld build-essential
          # Install Python tools in the activated environment
          pip install cython buildozer

      # 3. Android SDK Setup and License Acceptance
      - name: Accept Android Licenses
        run: |
          echo "Attempting to accept required Android SDK licenses..."
          mkdir -p ~/.android
          touch ~/.android/repositories.cfg
          $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses || true

      # 4. Create Custom Buildozer Configuration File (Using variables)
      - name: Generate buildozer.spec
        run: |
          cat << 'EOF' > buildozer.spec
          [app]
          title = BarcodeScanner
          package.name = barcodescanner
          package.domain = org.test
          source.dir = .
          source.include_exts = py,png,jpg,kv,atlas
          version = 1.0
          requirements = python3, kivy, opencv
          orientation = portrait
          fullscreen = 0
          android.permissions = INTERNET, CAMERA
          android.api = ${{ env.ANDROID_API }}
          android.minapi = ${{ env.ANDROID_MINAPI }}
          android.accept_sdk_license = True
          android.skip_apk_rescale = True
          p4a.branch = master
          
          # !!! WARNING: CRITICAL PATH !!! 
          # This MUST point to the correct NDK location on the runner machine.
          android.ndk_path = /usr/local/lib/android/sdk/ndk/${{ env.NDK_VERSION }}
          
          [buildozer]
          log_level = 2
          warn_on_root = 1
          EOF

      # 5. Build with Buildozer
      - name: Build APK using Buildozer
        env:
          ANDROID_NDK_HOME: /usr/local/lib/android/sdk/ndk/${{ env.NDK_VERSION }}
          # Stability flags to prevent common build errors
          USE_HARFBUZZ: "0" 
          USE_SDL2_IMAGE_WEBP: "0" 
          WERROR: "0"
          CFLAGS: "-Wno-error -Wno-format-security -Wno-macro-redefined"
          CXXFLAGS: "-Wno-error -Wno-format-security -Wno-macro-redefined"
        run: |
          echo "Starting Android build with verbosity level 2..."
          # Using 'set -e' within the shell script ensures that if any command fails, 
          # the entire job stops immediately instead of continuing into potentially broken commands.
          set -e
          buildozer -v android debug

      # 6. Upload APK Artifact
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: android-apk
          path: bin/*.apk
